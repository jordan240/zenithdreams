{% comment %} sections/collections-grid.liquid {% endcomment %}

<section class="section-pad" style="background: var(--bg-primary);" id="collections-grid">
  <div class="container">

    <div class="text-center mb-5 fade-up">
      <p class="section-subtitle">{{ section.settings.subtitle | default: 'Browse by Category' }}</p>
      <h2 class="section-title">{{ section.settings.title | default: 'Our Collections' }}</h2>
      <div class="gold-divider"></div>
    </div>

    <div class="row g-3 g-md-4">
      {%- for block in section.blocks -%}
        <div class="col-6 col-md-4 col-lg-3 fade-up" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: routes.collections_url }}" class="collection-card d-block text-decoration-none">
            <div class="collection-card-image">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 600 }}"
                     alt="{{ block.settings.name }}"
                     loading="lazy"
                     width="600" height="600">
              {%- else -%}
                <div class="img-placeholder" style="width:100%; height:100%; min-height: 200px;">
                  <span>{{ block.settings.name }}</span>
                </div>
              {%- endif -%}
            </div>
            <div class="collection-card-overlay">
              <div>
                <div class="collection-card-name">{{ block.settings.name | default: 'Collection' }}</div>
                <span class="collection-card-link">Shop Now →</span>
              </div>
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Collections Grid",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Browse by Category"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Our Collections"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Collection name",
          "default": "Hoodies"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Grid",
      "category": "Collection",
      "blocks": [
        { "type": "collection_card", "settings": { "name": "Hoodies" } },
        { "type": "collection_card", "settings": { "name": "Tees" } },
        { "type": "collection_card", "settings": { "name": "Accessories" } },
        { "type": "collection_card", "settings": { "name": "Outerwear" } }
      ]
    }
  ]
}
{% endschema %}
