{% comment %} sections/footer.liquid {% endcomment %}

<footer id="site-footer">
  <div class="container">
    <div class="row g-4 g-lg-5 pb-5">

      <!-- Col 1: Brand -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="footer-brand-name">{{ section.settings.brand_name | default: shop.name }}</div>
        <div class="gold-divider left mb-3"></div>
        <p class="footer-about">{{ section.settings.about_text | default: 'Where luxury meets the street. Zenith Dreams is more than a brand — it is a mindset.' }}</p>

        <!-- Social icons -->
        <div class="footer-social mt-4">
          {%- if section.settings.instagram != blank -%}
            <a href="{{ section.settings.instagram }}" aria-label="Instagram" rel="noopener noreferrer" target="_blank">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok != blank -%}
            <a href="{{ section.settings.tiktok }}" aria-label="TikTok" rel="noopener noreferrer" target="_blank">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9.19a8.16 8.16 0 0 0 4.77 1.52V7.26a4.85 4.85 0 0 1-1-.57z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.twitter != blank -%}
            <a href="{{ section.settings.twitter }}" aria-label="X / Twitter" rel="noopener noreferrer" target="_blank">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.pinterest != blank -%}
            <a href="{{ section.settings.pinterest }}" aria-label="Pinterest" rel="noopener noreferrer" target="_blank">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2C6.48 2 2 6.48 2 12c0 4.24 2.65 7.86 6.39 9.29-.09-.78-.17-1.98.04-2.83.18-.77 1.22-5.17 1.22-5.17s-.31-.62-.31-1.54c0-1.45.84-2.53 1.88-2.53.89 0 1.32.67 1.32 1.47 0 .89-.57 2.23-.86 3.47-.25 1.04.51 1.88 1.53 1.88 1.83 0 3.24-1.93 3.24-4.71 0-2.46-1.77-4.18-4.3-4.18-2.93 0-4.65 2.2-4.65 4.47 0 .88.34 1.83.76 2.34.08.1.09.19.07.29-.08.32-.25 1.04-.28 1.18-.04.19-.14.23-.32.14-1.25-.58-2.03-2.42-2.03-3.89 0-3.15 2.29-6.05 6.61-6.05 3.47 0 6.16 2.47 6.16 5.77 0 3.44-2.17 6.21-5.18 6.21-1.01 0-1.96-.53-2.29-1.14l-.62 2.33c-.22.86-.83 1.94-1.24 2.6.94.29 1.93.45 2.96.45 5.52 0 10-4.48 10-10S17.52 2 12 2z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="col-6 col-sm-3 col-lg-2 offset-lg-1">
        <div class="footer-heading">Quick Links</div>
        <ul class="footer-links">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.collections_url }}">Shop</a></li>
          <li><a href="/pages/about">About</a></li>
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/blogs/news">Journal</a></li>
        </ul>
      </div>

      <!-- Col 3: Customer Service -->
      <div class="col-6 col-sm-3 col-lg-2">
        <div class="footer-heading">Customer Service</div>
        <ul class="footer-links">
          <li><a href="/pages/shipping">Shipping Info</a></li>
          <li><a href="/pages/returns">Returns & Exchanges</a></li>
          <li><a href="/pages/size-guide">Size Guide</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
        </ul>
      </div>

      <!-- Col 4: Newsletter mini -->
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="footer-heading">Stay in the Loop</div>
        <p class="footer-about mb-3">Get early access to new drops and exclusive offers.</p>
        <form action="/contact#contact_form" method="post" accept-charset="UTF-8"
              style="display:flex; flex-direction:column; gap:8px;">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="email" name="contact[email]" placeholder="Your email"
                 style="background:var(--bg-primary); border:1px solid var(--border-subtle); color:#fff; font-size:0.82rem; padding:0.65em 1em; border-radius:2px; outline:none;">
          <button type="submit" class="btn-gold" style="font-size:0.68rem; padding:0.7em 1.2em;">Subscribe</button>
        </form>
      </div>

    </div><!-- /.row -->

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p>© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: shop.name }}. All rights reserved.</p>
      <p>
        <a href="/pages/terms" style="color:var(--text-secondary); font-size:0.75rem;">Terms</a>
        &ensp;·&ensp;
        <a href="/pages/privacy-policy" style="color:var(--text-secondary); font-size:0.75rem;">Privacy</a>
      </p>
    </div>

  </div><!-- /.container -->
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "Zenith Dreams"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "Brand tagline / about",
      "default": "Where luxury meets the street. Zenith Dreams is more than a brand — it is a mindset."
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "twitter",
      "label": "X / Twitter URL"
    },
    {
      "type": "url",
      "id": "pinterest",
      "label": "Pinterest URL"
    }
  ]
}
{% endschema %}
