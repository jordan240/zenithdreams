{% comment %} sections/header.liquid {% endcomment %}

<header id="site-header" class="transparent">
  <div class="container">
    <div class="header-inner">

      <!-- Logo -->
      <a href="{{ routes.root_url }}" class="header-logo">
        {%- if section.settings.logo != blank -%}
          <img src="{{ section.settings.logo | image_url: width: 220 }}"
               alt="{{ shop.name }}"
               width="110" height="auto"
               loading="eager">
        {%- else -%}
          {{ section.settings.logo_text | default: shop.name }}
        {%- endif -%}
      </a>

      <!-- Desktop nav -->
      <nav aria-label="Primary navigation">
        <ul class="header-nav">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.collections_url }}">Shop</a></li>
          <li><a href="/collections/all">Collections</a></li>
          <li><a href="/pages/about">About</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </nav>

      <!-- Icons -->
      <div class="header-icons">
        <!-- Search -->
        <button class="header-icon-btn" aria-label="Search" onclick="document.querySelector('.header-search-bar')?.classList.toggle('open')">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </button>

        <!-- Account -->
        <a href="{{ routes.account_url }}" class="header-icon-btn" aria-label="Account">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>

        <!-- Cart -->
        <button class="header-icon-btn" aria-label="Cart ({{ cart.item_count }} items)" data-cart-open>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count" aria-hidden="true">{{ cart.item_count }}</span>
          {%- endif -%}
        </button>

        <!-- Hamburger -->
        <button class="hamburger" aria-label="Toggle menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div><!-- /.header-inner -->
  </div><!-- /.container -->
</header>

<!-- Mobile nav overlay -->
<nav class="mobile-nav" aria-label="Mobile navigation">
  <a href="{{ routes.root_url }}">Home</a>
  <a href="{{ routes.collections_url }}">Shop</a>
  <a href="/collections/all">Collections</a>
  <a href="/pages/about">About</a>
  <a href="/pages/contact">Contact</a>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text (if no image)",
      "default": "Zenith Dreams"
    }
  ]
}
{% endschema %}
