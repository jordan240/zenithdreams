{% comment %} sections/lookbook.liquid {% endcomment %}

<section class="lookbook-section section-pad" id="lookbook">
  <div class="container-fluid px-0 px-md-3">

    {%- for block in section.blocks -%}
      {%- assign reverse = forloop.index | modulo: 2 -%}
      <div class="row g-0 g-md-4 mb-4 mb-md-5 align-items-stretch {% if reverse == 0 %}flex-md-row-reverse{% endif %}">

        <!-- Image -->
        <div class="col-md-6 fade-up">
          <div class="lookbook-image-wrap">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}"
                   alt="{{ block.settings.heading }}"
                   loading="lazy"
                   width="900" height="auto">
            {%- else -%}
              <div class="img-placeholder" style="aspect-ratio:4/5; min-height: 400px;">
                <span>Lookbook Image</span>
              </div>
            {%- endif -%}
          </div>
        </div>

        <!-- Text -->
        <div class="col-md-6 fade-up">
          <div class="lookbook-content h-100">
            <p class="section-subtitle">{{ block.settings.eyebrow | default: 'Brand Story' }}</p>
            <h2 class="section-title mb-3">{{ block.settings.heading | default: 'Crafted for the Bold' }}</h2>
            <div class="gold-divider left mb-4"></div>
            <p>{{ block.settings.body | default: 'Zenith Dreams was born from the intersection of luxury and street culture. Each piece is designed to push boundaries — refined silhouettes, premium fabrics, and an unapologetic attitude.' }}</p>
            <a href="{{ block.settings.cta_link | default: '/pages/about' }}" class="btn-outline-gold">
              {{ block.settings.cta_text | default: 'Discover More' }}
            </a>
          </div>
        </div>

      </div>
    {%- endfor -%}

  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "lookbook_item",
      "name": "Lookbook Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "Brand Story"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Crafted for the Bold"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body text"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA text",
          "default": "Discover More"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "CTA link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "category": "Content",
      "blocks": [
        { "type": "lookbook_item" }
      ]
    }
  ]
}
{% endschema %}
