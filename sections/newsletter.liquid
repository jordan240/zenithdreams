{% comment %} sections/newsletter.liquid {% endcomment %}

<section class="newsletter-section section-pad" id="newsletter">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6 text-center fade-up">
        <p class="section-subtitle">{{ section.settings.subtitle | default: 'Exclusive Access' }}</p>
        <h2 class="section-title mb-2">{{ section.settings.title | default: 'Join the Dream' }}</h2>
        <div class="gold-divider mb-4"></div>
        <p class="text-muted mb-4" style="font-size:0.92rem; line-height:1.75;">
          {{ section.settings.body | default: 'Be the first to know about new drops, limited releases, and exclusive members-only offers. No spam, just the good stuff.' }}
        </p>

        <form class="newsletter-form" action="/contact#contact_form" method="post" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="email"
                 name="contact[email]"
                 placeholder="{{ section.settings.placeholder | default: 'Your email address' }}"
                 required
                 autocomplete="email"
                 aria-label="Email address">
          <button type="submit">
            {{ section.settings.button_text | default: 'Subscribe' }}
          </button>
        </form>

        <p style="font-size:0.7rem; color: var(--text-secondary); margin-top: 1rem;">
          {{ section.settings.disclaimer | default: 'We respect your privacy. Unsubscribe anytime.' }}
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Exclusive Access"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Join the Dream"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "We respect your privacy. Unsubscribe anytime."
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "category": "Email"
    }
  ]
}
{% endschema %}
