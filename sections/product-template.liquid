{% comment %} sections/product-template.liquid {% endcomment %}

<div style="padding-top: 100px;" class="section-pad">
  <div class="container">

    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
      <ol style="list-style:none; display:flex; gap:0.5rem; flex-wrap:wrap; padding:0; margin:0;">
        <li><a href="{{ routes.root_url }}" class="text-muted" style="font-size:0.75rem; letter-spacing:0.1em;">Home</a></li>
        <li style="color:var(--text-secondary); font-size:0.75rem;">/</li>
        <li><a href="{{ product.collections.first.url }}" class="text-muted" style="font-size:0.75rem;">{{ product.collections.first.title | default: 'Shop' }}</a></li>
        <li style="color:var(--text-secondary); font-size:0.75rem;">/</li>
        <li style="color:var(--accent); font-size:0.75rem;">{{ product.title }}</li>
      </ol>
    </nav>

    <div class="row g-4 g-lg-5">

      <!-- Left: Gallery -->
      <div class="col-12 col-lg-6">
        <div class="product-gallery-main fade-up">
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 900 }}"
                 alt="{{ product.featured_image.alt | escape }}"
                 id="main-product-image"
                 loading="eager"
                 width="900" height="auto">
          {%- else -%}
            <div class="img-placeholder">
              <span>{{ product.title }}</span>
            </div>
          {%- endif -%}
        </div>

        <!-- Thumbnails -->
        {%- if product.images.size > 1 -%}
          <div class="product-gallery-thumbs fade-up">
            {%- for image in product.images limit: 6 -%}
              <div class="product-thumb {% if forloop.first %}active{% endif %}"
                   data-src="{{ image | image_url: width: 900 }}">
                <img src="{{ image | image_url: width: 140 }}"
                     alt="{{ image.alt | escape }}"
                     loading="lazy">
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Right: Info -->
      <div class="col-12 col-lg-6">
        <div class="product-info fade-up">

          {%- if product.collections.first -%}
            <p class="section-subtitle">{{ product.collections.first.title }}</p>
          {%- endif -%}

          <h1 style="font-family:var(--font-serif); font-size:clamp(1.6rem,3vw,2.4rem); margin-bottom:0.4em;">
            {{ product.title }}
          </h1>

          <div class="product-price">
            {{ product.price | money }}
            {%- if product.compare_at_price > product.price -%}
              <s>{{ product.compare_at_price | money }}</s>
            {%- endif -%}
          </div>

          {%- form 'product', product, id: 'product-form' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

            <!-- Size selector -->
            {%- unless product.has_only_default_variant -%}
              {%- for option in product.options_with_values -%}
                <div class="size-selector">
                  <label>{{ option.name }}</label>
                  <div class="size-options">
                    {%- for value in option.values -%}
                      <button type="button"
                              class="size-btn {% if forloop.first %}selected{% endif %}"
                              data-option="{{ option.position }}"
                              data-value="{{ value }}">
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            {%- endunless -%}

            <!-- Quantity -->
            <div class="qty-selector mb-4">
              <button type="button" class="qty-btn" data-action="decrease" aria-label="Decrease quantity">−</button>
              <input type="number" name="quantity" value="1" min="1" class="qty-input" aria-label="Quantity">
              <button type="button" class="qty-btn" data-action="increase" aria-label="Increase quantity">+</button>
            </div>

            <!-- Add to Cart -->
            <div class="d-flex gap-3 mb-3">
              <button type="submit" name="add" class="btn-gold flex-grow-1"
                      {% unless product.available %}disabled{% endunless %}>
                {%- if product.available -%}Add to Cart{%- else -%}Sold Out{%- endif -%}
              </button>
            </div>

            <p style="font-size:0.72rem; color:var(--text-secondary); letter-spacing:0.1em;">
              <a href="/pages/size-guide" style="color:var(--accent);">Size Guide</a>
              &nbsp;·&nbsp; Free shipping on orders over $150
            </p>

          {%- endform -%}

          <!-- Description & Accordion -->
          <div class="mt-4">
            <div class="accordion accordion-zd" id="product-accordion">

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button" type="button"
                          data-bs-toggle="collapse" data-bs-target="#desc-collapse">
                    Description
                  </button>
                </h2>
                <div id="desc-collapse" class="accordion-collapse collapse show"
                     data-bs-parent="#product-accordion">
                  <div class="accordion-body">
                    {{ product.description | default: 'Premium quality streetwear crafted with meticulous attention to detail. Designed for those who appreciate luxury in everyday wear.' }}
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button"
                          data-bs-toggle="collapse" data-bs-target="#shipping-collapse">
                    Shipping & Returns
                  </button>
                </h2>
                <div id="shipping-collapse" class="accordion-collapse collapse"
                     data-bs-parent="#product-accordion">
                  <div class="accordion-body">
                    Free standard shipping on orders over $150. Express shipping available at checkout. Returns accepted within 30 days of delivery for unworn, unwashed items with tags attached.
                  </div>
                </div>
              </div>

              <div class="accordion-item">
                <h2 class="accordion-header">
                  <button class="accordion-button collapsed" type="button"
                          data-bs-toggle="collapse" data-bs-target="#care-collapse">
                    Care Instructions
                  </button>
                </h2>
                <div id="care-collapse" class="accordion-collapse collapse"
                     data-bs-parent="#product-accordion">
                  <div class="accordion-body">
                    Machine wash cold on gentle cycle. Do not tumble dry — lay flat or hang to dry. Do not bleach. Iron on low heat if needed.
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Related products -->
    {%- if product.collections.first.products.size > 1 -%}
      <div class="mt-5 pt-5" style="border-top: 1px solid var(--border-subtle);">
        <div class="text-center mb-5 fade-up">
          <p class="section-subtitle">You May Also Like</p>
          <h2 class="section-title">Related Products</h2>
          <div class="gold-divider"></div>
        </div>
        <div class="row g-4">
          {%- for related in product.collections.first.products limit: 4 -%}
            {%- unless related.id == product.id -%}
              <div class="col-6 col-md-4 col-lg-3 fade-up">
                {% render 'product-card', product: related %}
              </div>
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
